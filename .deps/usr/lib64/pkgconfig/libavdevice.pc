prefix=/home/gautham/syncplay-alt/.deps/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=/home/gautham/syncplay-alt/.deps/usr/include/ffmpeg

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.3.103
Requires: 
Requires.private: libavfilter >= 11.14.103, libswscale >= 9.5.103, libavformat >= 62.12.103, libavcodec >= 62.28.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavdevice 
Libs.private: -lm -latomic -L/usr/lib64/pipewire-0.3/jack -ljack -ldrm -lopenal -lxcb -lxcb-shm -lxcb-shape -lxcb-xfixes -lcdio_paranoia -lcdio_cdda -lcdio -lm -lasound -lpulse -pthread -lv4l2
Cflags: -I${includedir}
