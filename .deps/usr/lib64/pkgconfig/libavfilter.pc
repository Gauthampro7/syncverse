prefix=/home/gautham/syncplay-alt/.deps/usr
exec_prefix=${prefix}
libdir=/usr/lib64
includedir=/home/gautham/syncplay-alt/.deps/usr/include/ffmpeg

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.14.103
Requires: 
Requires.private: libswscale >= 9.5.103, libavformat >= 62.12.103, libavcodec >= 62.28.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -pthread -lm -latomic -lz -lbs2b -llilv-0 -lrubberband -lfftw3 -lsamplerate -lstdc++ -lmysofa -lharfbuzz -lfribidi -llcms2 -lplacebo -lvmaf -ltesseract -lass -lva -lvidstab -lm -fopenmp -lzmq -lzimg -lshaderc_shared -lOpenCL -lqrencode -lfontconfig -lfreetype -L/usr/lib64/pkgconfig/../ -lvpl -ldl
Cflags: -I${includedir}
