// ==============================================================================
// Syncplay-Alt Windows Resource Script
// Defines application icon, version metadata, and per-monitor DPI awareness
// ==============================================================================

#define IDI_APPLICATION 101

// Application Icon
IDI_APPLICATION ICON "../../assets/syncplay-alt.ico"

// Version Information
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       0x1L
#else
FILEFLAGS       0x0L
#endif
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Syncplay Alt Project"
            VALUE "FileDescription",  "Syncplay Alt - Standalone Synchronized Desktop Media Player"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "syncplay-alt"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Syncplay Alt Contributors"
            VALUE "OriginalFilename", "syncplay-alt.exe"
            VALUE "ProductName",      "Syncplay Alt"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Enable Per-Monitor DPI Awareness V2 for Crisp High-DPI UI Rendering
1 24 "syncplay-alt.manifest"
