// ==============================================================================
// Syncverse Windows Resource Script
// Defines application icon, version metadata, and per-monitor DPI awareness
// ==============================================================================

#define IDI_APPLICATION 101

// Application Icon
IDI_APPLICATION ICON "../../assets/syncverse.ico"

// Version Information
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       0x1L
#else
FILEFLAGS       0x0L
#endif
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Syncverse Project"
            VALUE "FileDescription",  "Syncverse - Standalone Synchronized Desktop Media Player"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "syncverse"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Gautham"
            VALUE "OriginalFilename", "syncverse.exe"
            VALUE "ProductName",      "Syncverse"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Enable Per-Monitor DPI Awareness V2 for Crisp High-DPI UI Rendering
1 24 "syncverse.manifest"
